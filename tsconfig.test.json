{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "out-test",
    "rootDir": ".",
    "noEmit": false
  },
  "include": ["src/core/**/*.ts", "src/shared/**/*.ts", "test/**/*.ts"],
  "exclude": ["test/smoke/**"]
}
